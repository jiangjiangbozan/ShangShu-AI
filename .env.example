# ====================================================================
# AI 开放平台 Docker 部署环境变量模板
# 使用方法：复制为 .env 并修改敏感值
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# ====================================================================

# ---------- 必填：安全密钥（启动前必须修改） ----------
# JWT 签名密钥，至少 32 字符，可用以下命令生成：
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
AI_AUTH_JWT_SECRET=请修改为至少32字符的随机字符串
# Jasypt 配置加密主密钥
JASYPT_ENCRYPTOR_PASSWORD=请修改为强密码

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DB=ai_agent
MYSQL_USER=ai_agent
MYSQL_PASSWORD=ai_agent_123

# ---------- Redis ----------
REDIS_PASSWORD=redis123456

# ---------- RabbitMQ ----------
RABBITMQ_USER=ai_agent
RABBITMQ_PASSWORD=rabbit123456

# ---------- Ollama ----------
OLLAMA_MODEL_ID=qwen3:8b

# ---------- DeepSeek（可选，不使用可留占位值） ----------
DEEPSEEK_API_KEY=sk-placeholder

# ---------- JVM ----------
JAVA_OPTS=-Xms256m -Xmx512m

# ---------- 邮件（可选，注册验证/找回密码） ----------
SMTP_HOST=smtp.placeholder.local
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
