# IDE 与编辑器 & 本机 AI 工具链配置
# ---------------------------------------------------------------------
.idea/
.trae/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.classpath
.project
.settings/
.factorypath
*.swp
*.swo
*~

