# =====================================================================
# 尚枢 AI (ShangShu AI) — 根级忽略规则
# 适用范围：公开仓库「核心工程」上传（api + ai-agent-web + ai-agent-client + ai-agent-mini）
# =====================================================================

# ---------------------------------------------------------------------
# 专属排除：公开仓库不上传
# 1) 外部参考项目（各自是独立 git 仓库，自行管理）
# 2) 个人文档目录（含简历/面试题/内部开发日志/敏感笔记等，不可公开）
# 如需公开 docs 中个别文档（如 docs/api、docs/architecture），请将下方 /docs/ 删除
#   并改为显式忽略其中的敏感子目录（如 /docs/interview/、/docs/origin/、/docs/dev-log/）
# ---------------------------------------------------------------------
/dify/
/Operit/
/docs/

# ---------------------------------------------------------------------
# 环境变量与密钥（绝不提交）
# 保留 .env.example 作为模板，忽略真实 .env 及其变体
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.properties.local
*.yml.local
*.yaml.local
secrets/
*.pem
*.key
!test/*.pem.nopkcs8

# ---------------------------------------------------------------------
# 通用日志
# ---------------------------------------------------------------------
logs/
*.log
logs/**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# 后端（Java / Maven / Spring Boot）
# ---------------------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
**/target/
.mvn/timing.properties
.mvn/.maven.config
hs_err_pid*
replay_pid*

# ---------------------------------------------------------------------
# 前端（Node / Vue / Vite）
# ---------------------------------------------------------------------
node_modules/
dist/
coverage/
*.local
.vite/
.eslintcache
.turbo/
.pnpm-store/

# ---------------------------------------------------------------------
# Android（Gradle / Kotlin / Compose）
# ---------------------------------------------------------------------
.gradle/
build/
**/build/
local.properties
*.apk
*.aab
*.aar
*.keystore
!debug.keystore
.cxx/
CMakeCache.txt
*.so
captures/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------------
# 根目录依赖解压产物（勿提交）
# 仅匹配根目录路径，避免误伤 api/ 内合法目录
# ---------------------------------------------------------------------
/org/
/META-INF/

