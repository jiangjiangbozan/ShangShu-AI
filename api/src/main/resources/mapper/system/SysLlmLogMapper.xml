<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- LLM 调用日志 Mapper XML -->
<!-- 依据《企业Java后端开发规范.md》§6：复杂查询写在 XML，单表 CRUD 由 BaseMapper 提供 -->
<mapper namespace="com.ai.api.data.mapper.SysLlmLogMapper">

    <resultMap id="BaseResultMap" type="com.ai.api.data.entity.SysLlmLog">
        <id column="id" property="id"/>
        <result column="trace_id" property="traceId"/>
        <result column="model_id" property="modelId"/>
        <result column="prompt" property="prompt"/>
        <result column="response" property="response"/>
        <result column="prompt_tokens" property="promptTokens"/>
        <result column="completion_tokens" property="completionTokens"/>
        <result column="total_tokens" property="totalTokens"/>
        <result column="latency_ms" property="latencyMs"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="creator" property="creator"/>
        <result column="create_time" property="createTime"/>
        <result column="updater" property="updater"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, trace_id, model_id, prompt, response,
        prompt_tokens, completion_tokens, total_tokens,
        latency_ms, status, error_msg,
        creator, create_time, updater, update_time, deleted
    </sql>

    <!-- 按 traceId 查询调用链路日志 -->
    <select id="selectByTraceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_llm_log
        WHERE deleted = 0
          AND trace_id = #{traceId}
        ORDER BY id ASC
    </select>

    <!-- 按模型与时间范围统计调用 -->
    <select id="selectByModelIdAndTimeRange" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_llm_log
        WHERE deleted = 0
          AND model_id = #{modelId}
          AND create_time &gt;= #{startTime}
          AND create_time &lt;= #{endTime}
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>
</mapper>
