<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 系统模型配置 Mapper XML -->
<!-- 依据《企业Java后端开发规范.md》§6：复杂查询写在 XML，单表 CRUD 由 BaseMapper 提供 -->
<mapper namespace="com.ai.api.data.mapper.SysModelConfigMapper">

    <resultMap id="BaseResultMap" type="com.ai.api.data.entity.SysModelConfig">
        <id column="id" property="id"/>
        <result column="provider" property="provider"/>
        <result column="model_id" property="modelId"/>
        <result column="display_name" property="displayName"/>
        <result column="api_key" property="apiKey"/>
        <result column="base_url" property="baseUrl"/>
        <result column="enabled" property="enabled"/>
        <result column="creator" property="creator"/>
        <result column="create_time" property="createTime"/>
        <result column="updater" property="updater"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 公共列（用于 SELECT 复用） -->
    <sql id="Base_Column_List">
        id, provider, model_id, display_name, api_key, base_url, enabled,
        creator, create_time, updater, update_time, deleted
    </sql>

    <!-- 按 provider 查询启用的模型配置 -->
    <select id="selectByProvider" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_model_config
        WHERE deleted = 0
          AND provider = #{provider}
        ORDER BY id DESC
    </select>

    <!-- 按 modelId 精确查询 -->
    <select id="selectByModelId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_model_config
        WHERE deleted = 0
          AND model_id = #{modelId}
        LIMIT 1
    </select>

    <!-- 查询所有启用的模型配置 -->
    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_model_config
        WHERE deleted = 0
          AND enabled = 1
        ORDER BY provider, model_id
    </select>
</mapper>
