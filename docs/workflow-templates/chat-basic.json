        "data": { "answer": { "nodeId": "llm-1", "outputKey": "text" } }
      },
      { "id": "end", "type": "end", "position": { "x": 900, "y": 200 }, "data": {} }
    ],
    "edges": [
      { "source": "start", "target": "llm-1" },
      { "source": "llm-1", "target": "answer-1" },
      { "source": "answer-1", "target": "end" }
    ]
  }
