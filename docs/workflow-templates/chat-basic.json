        "position": { "x": 80, "y": 200 },
        "data": {
          "variables": [{ "variable": "question", "default": "你好，请介绍一下你自己" }]
        }
      },
      {
        "id": "llm-1",
        "type": "llm",
        "position": { "x": 380, "y": 200 },
        "data": {
